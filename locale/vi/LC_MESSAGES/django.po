#: templates/account/login.html:220 templates/admin/login.html:234
msgid "Welcome back"
msgstr "Chào mừng trở lại"

#: templates/account/login.html:221 templates/admin/login.html:235
msgid "Sign in to your account"
msgstr "Đăng nhập vào tài khoản của bạn"

#: templates/account/login.html:245 templates/admin/login.html:261
