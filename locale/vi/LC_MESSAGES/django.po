#: templates/account/password_reset.html:7
msgid "Forgot Password"
msgstr "Quên Mật Khẩu"

#: templates/account/password_reset.html:93
msgid "Forgot Password?"
msgstr "Quên mật khẩu?"

#: templates/account/password_reset.html:97
msgid "Enter your email address and we'll send you a link to reset your password."
msgstr "Nhập địa chỉ email của bạn, chúng tôi sẽ gửi link đặt lại mật khẩu."

#: templates/account/password_reset.html:112
msgid "Send Reset Link"
msgstr "Gửi Link Đặt Lại"

#: templates/account/password_reset.html:116
msgid "Remember your password?"
msgstr "Nhớ mật khẩu rồi?"

#: templates/account/password_reset.html:117 templates/account/signup.html:206
msgid "Sign in"
msgstr "Đăng nhập"

#: templates/account/password_reset_done.html:7
#: templates/account/password_reset_done.html:59
msgid "Check Your Email"
msgstr "Kiểm Tra Email"

#: templates/account/password_reset_done.html:64
msgid "Email sent!"
msgstr "Đã gửi email!"

#: templates/account/password_reset_done.html:65
msgid "We've sent a password reset link to your email address. Please check your inbox and follow the instructions."
msgstr "Chúng tôi đã gửi link đặt lại mật khẩu đến email của bạn. Vui lòng kiểm tra hộp thư và làm theo hướng dẫn."

#: templates/account/password_reset_done.html:66
#: templates/account/password_reset_from_key.html:113
msgid "Back to Sign In"
msgstr "Quay lại Đăng Nhập"

#: templates/account/password_reset_from_key.html:7
#: templates/account/password_reset_from_key.html:83
#: templates/account/password_reset_from_key.html:108
msgid "Set New Password"
msgstr "Đặt Mật Khẩu Mới"

#: templates/account/password_reset_from_key.html:89
msgid "This password reset link is invalid or has expired."
msgstr "Link đặt lại mật khẩu này không hợp lệ hoặc đã hết hạn."

#: templates/account/password_reset_from_key.html:91
msgid "Request a new one"
msgstr "Yêu cầu link mới"

#: templates/account/password_reset_from_key_done.html:7
#: templates/account/password_reset_from_key_done.html:57
msgid "Password Changed"
msgstr "Đổi Mật Khẩu Thành Công"

#: templates/account/password_reset_from_key_done.html:62
msgid "All done!"
msgstr "Hoàn tất!"

#: templates/account/password_reset_from_key_done.html:63
msgid "Your password has been changed successfully. You can now sign in with your new password."
msgstr "Mật khẩu của bạn đã được thay đổi thành công. Bạn có thể đăng nhập bằng mật khẩu mới."

#: templates/account/signup.html:7 templates/account/signup.html:200
msgid "Sign Up"
msgstr "Đăng Ký"

#: templates/account/signup.html:176
msgid "Create account"
msgstr "Tạo tài khoản"

#: templates/account/signup.html:177
msgid "Fill in the details below to get started"
msgstr "Điền thông tin bên dưới để bắt đầu"

#: templates/account/signup.html:205
msgid "Already have an account?"
msgstr "Đã có tài khoản?"

#: templates/admin/login.html:7
msgid "Administration"
msgstr "Quản Trị"

#: templates/admin/login.html:242
msgid "Invalid username or password. Please try again."
msgstr "Tên đăng nhập hoặc mật khẩu không đúng. Vui lòng thử lại."

#: templates/admin/login.html:251
msgid "Username or Email"
msgstr "Tên đăng nhập hoặc Email"

#: templates/admin/login.html:258
msgid "Password"
